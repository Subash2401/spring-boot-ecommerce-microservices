# MySQL
DB_PASSWORD=
USER_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=

# PostgreSQL
POSTGRES_PASSWORD=

# MongoDB
MONGO_USERNAME=
MONGO_PASSWORD=
PRODUCT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# Security
JWT_SECRET=

# Config Server
# CONFIG_GIT_URI: the Git repo with the services' .properties files (https://...git)
CONFIG_GIT_URI=
CONFIG_GIT_USERNAME=
# Optional: sub-folder with the files (empty = repo root; config-repo-example for the public repo)
CONFIG_GIT_SEARCH_PATHS=
GITLAB_TOKEN=
CONFIG_USERNAME=
CONFIG_PASSWORD=
REDIS_PASSWORD=
EUREKA_USERNAME=
EUREKA_PASSWORD=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production only (compose.prod.yaml, see docs/DEPLOY.md)
# DOMAIN: the site's name without https://, for example shop.example.com
DOMAIN=
# LETSENCRYPT_EMAIL: where Let's Encrypt sends certificate expiry warnings
LETSENCRYPT_EMAIL=
# Optional, both default to true (SMTP login + STARTTLS, what port 587 expects)
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
